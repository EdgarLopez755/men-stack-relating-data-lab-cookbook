<!DOCTYPE html>
<html>
<head>
  <title>Edit Food Item</title>
</head>
<body>
  <h1>Edit Food Item</h1>

  <form action="/update-food/<%= food._id %>" method="POST">
    <input type="hidden" name="id" value="<%= food._id %>">

    <label for="name">Food Name:</label>
    <input type="text" id="name" name="name" value="<%= food.name %>"><br>

    <label for="quantity">Quantity:</label>
    <input type="number" id="quantity" name="quantity" value="<%= food.quantity %>"><br>

    <label for="expirationDate">Expiration Date:</label>
    <input type="number" id="expirationDate" name="expirationDate" value="<%= food.expirationDate %>"><br>

    <label for="notes">Notes:</label>
    <textarea id="notes" name="notes"><%= food.notes %></textarea><br>

    <button type="submit">Update Food</button>
  </form>
</body>
</html>